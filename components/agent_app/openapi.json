{
  "openapi": "3.1.0",
  "info": {
    "title": "Kalayaan Mutual claims assistant",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz"
                }
              }
            }
          }
        }
      }
    },
    "/countries": {
      "get": {
        "summary": "Countries",
        "operationId": "countries",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CountryInfo"
                  },
                  "type": "array",
                  "title": "Response Countries"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{doc_id}": {
      "get": {
        "summary": "Document",
        "operationId": "document",
        "parameters": [
          {
            "name": "doc_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Doc Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "summary": "Chat",
        "operationId": "chat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/approve": {
      "post": {
        "summary": "Approve",
        "operationId": "approve",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApproveResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reject": {
      "post": {
        "summary": "Reject",
        "operationId": "reject",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RejectResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprovalRequest": {
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z]{2}-\\d{3,6}$",
            "title": "Claim Id"
          },
          "token": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "claim_id",
          "token"
        ],
        "title": "ApprovalRequest"
      },
      "ApproveResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "filed",
            "title": "Status"
          },
          "claim": {
            "$ref": "#/components/schemas/ClaimView"
          }
        },
        "type": "object",
        "required": [
          "status",
          "claim"
        ],
        "title": "ApproveResponse"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          },
          "country": {
            "type": "string",
            "maxLength": 2,
            "minLength": 2,
            "title": "Country"
          },
          "language": {
            "type": "string",
            "maxLength": 3,
            "minLength": 2,
            "title": "Language"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "tier_override": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "small",
                  "large"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Tier Override"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryMessage"
            },
            "type": "array",
            "maxItems": 20,
            "title": "History"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message",
          "country",
          "language"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "country": {
            "type": "string",
            "title": "Country"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "notice": {
            "type": "string",
            "title": "Notice"
          },
          "pending_approvals": {
            "items": {
              "$ref": "#/components/schemas/PendingApproval"
            },
            "type": "array",
            "title": "Pending Approvals"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "country",
          "language",
          "answer",
          "citations",
          "notice",
          "usage"
        ],
        "title": "ChatResponse"
      },
      "Citation": {
        "properties": {
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "heading": {
            "type": "string",
            "title": "Heading"
          },
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "country": {
            "type": "string",
            "title": "Country"
          }
        },
        "type": "object",
        "required": [
          "number",
          "doc_id",
          "title",
          "heading",
          "chunk_id",
          "country"
        ],
        "title": "Citation"
      },
      "ClaimView": {
        "properties": {
          "claim_id": {
            "type": "string",
            "title": "Claim Id"
          },
          "country": {
            "type": "string",
            "title": "Country"
          },
          "claim_type": {
            "type": "string",
            "title": "Claim Type"
          },
          "incident_date": {
            "type": "string",
            "title": "Incident Date"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "amount_claimed": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Claimed"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "policy_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Number"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "filed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filed At"
          }
        },
        "type": "object",
        "required": [
          "claim_id",
          "country",
          "claim_type",
          "incident_date",
          "description",
          "currency",
          "status"
        ],
        "title": "ClaimView"
      },
      "CountryInfo": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "languages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Languages"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "languages"
        ],
        "title": "CountryInfo"
      },
      "DocumentView": {
        "properties": {
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "country": {
            "type": "string",
            "title": "Country"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "body": {
            "type": "string",
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "doc_id",
          "title",
          "country",
          "language",
          "body"
        ],
        "title": "DocumentView"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "HistoryMessage"
      },
      "PendingApproval": {
        "properties": {
          "claim_id": {
            "type": "string",
            "title": "Claim Id"
          },
          "token": {
            "type": "string",
            "title": "Token"
          },
          "expires_at": {
            "type": "integer",
            "title": "Expires At"
          },
          "draft": {
            "$ref": "#/components/schemas/ClaimView"
          }
        },
        "type": "object",
        "required": [
          "claim_id",
          "token",
          "expires_at",
          "draft"
        ],
        "title": "PendingApproval"
      },
      "RejectResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "rejected_by_user",
            "title": "Status"
          },
          "claim_id": {
            "type": "string",
            "title": "Claim Id"
          }
        },
        "type": "object",
        "required": [
          "status",
          "claim_id"
        ],
        "title": "RejectResponse"
      },
      "Route": {
        "properties": {
          "tier": {
            "type": "string",
            "title": "Tier"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "deployment": {
            "type": "string",
            "title": "Deployment"
          },
          "intent": {
            "type": "string",
            "title": "Intent",
            "default": "other"
          },
          "risk": {
            "type": "string",
            "title": "Risk",
            "default": "low"
          }
        },
        "type": "object",
        "required": [
          "tier",
          "reason",
          "deployment"
        ],
        "title": "Route"
      },
      "Usage": {
        "properties": {
          "route": {
            "$ref": "#/components/schemas/Route"
          },
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens"
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens"
          },
          "cached_tokens": {
            "type": "integer",
            "title": "Cached Tokens"
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit"
          },
          "levers_fired": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Levers Fired"
          },
          "steps_used": {
            "type": "integer",
            "title": "Steps Used"
          },
          "loop_capped": {
            "type": "boolean",
            "title": "Loop Capped"
          },
          "tool_calls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tool Calls"
          },
          "fallback_used": {
            "type": "boolean",
            "title": "Fallback Used",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "route",
          "input_tokens",
          "output_tokens",
          "cached_tokens",
          "cost_usd",
          "latency_ms",
          "cache_hit",
          "levers_fired",
          "steps_used",
          "loop_capped"
        ],
        "title": "Usage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
